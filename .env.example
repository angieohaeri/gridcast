# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TAILSCALE_HOST=angies-server

# TimescaleDB
TIMESCALEDB_HOST=localhost
TIMESCALEDB_PORT=5432
TIMESCALEDB_DB=gridcast
TIMESCALEDB_USER=
TIMESCALEDB_PASSWORD=
TIMESCALEDB_URL=

# ISO / EIA
EIA_API_KEY=
PJM_API_KEY=

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000


PREFECT_API_URL=http://localhost:4200/api

# Cloudflare
CLOUDFLARE_TUNNEL_TOKEN=

# rclone remote:path the db_backup flow syncs nightly dumps to (remote itself is
# configured once on the host via `rclone config`, not through env vars - see
# references/decisions.md)
RCLONE_REMOTE=gdrive:gridcast-backups

# Open Meteo API
HISTORICAL_API=https://historical-forecast-api.open-meteo.com/v1/forecast
FORECAST_API=https://api.open-meteo.com/v1/forecast